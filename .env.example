# Byblos frontend (Vite) environment. Copy to .env and fill in.
# Only VITE_-prefixed vars are exposed to the client bundle — never put secrets here.

# API + site URLs
VITE_API_URL=
VITE_NATIVE_API_URL=
VITE_PUBLIC_WEB_URL=

# App version shown in device-token registration
VITE_APP_VERSION=

# Google Search Console site verification token
VITE_GOOGLE_SITE_VERIFICATION=

# --- Web Push (FCM) ---
# Firebase Web app config. These are client-safe by Firebase's design (they ship
# in the bundle regardless) — distinct from the server-side FIREBASE_SERVICE_ACCOUNT.
# Use the SAME Firebase project as native push. Find these in the Firebase
# console → Project settings → General → "Your apps" (Web app config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair (VAPID public key). Firebase console →
# Project settings → Cloud Messaging → Web configuration → "Web Push certificates".
# Required by getToken() to mint a web push token; also baked into the generated
# service worker (scripts/generate-firebase-sw.mjs) at build time.
VITE_FCM_VAPID_KEY=
