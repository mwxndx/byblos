{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "byblosafrica.site" }],
      "destination": "https://www.byblosafrica.site/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://byblos-backend-fky5.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
