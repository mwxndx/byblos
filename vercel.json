{
  "redirects": [
    {
      "source": "/((?!\\.well-known/).*)",
      "has": [{ "type": "host", "value": "byblosafrica.site" }],
      "destination": "https://www.byblosafrica.site/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.byblosafrica.site/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
