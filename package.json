{
  "name": "byblos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate-firebase-sw && vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --skipLibCheck",
    "build": "npm run typecheck && npm run generate-sitemap && npm run generate-firebase-sw && vite build && npm run prerender",
    "build:dev": "npm run generate-firebase-sw && vite build --mode development",
    "vercel-build": "npm run typecheck && npm run generate-sitemap && npm run generate-firebase-sw && vite build --mode production && npm run prerender",
    "prerender": "node scripts/prerender-public-pages.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "generate-firebase-sw": "node scripts/generate-firebase-sw.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:app": "node scripts/app-system-audit.mjs",
    "test:journeys": "npm --prefix server run test:journeys",
    "test:journeys:gate1": "npm --prefix server run test:journeys:gate1",
    "test:journeys:gate2": "npm --prefix server run test:journeys:gate2",
    "test:journeys:gate3": "npm --prefix server run test:journeys:gate3",
    "test:journeys:gate4": "npm --prefix server run test:journeys:gate4",
    "test:staging:smoke": "node scripts/staging-smoke-test.mjs",
    "test:env:check": "node scripts/test-env-check.mjs",
    "test:env:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:env:down": "docker compose -f docker-compose.test.yml down -v",
    "test:env:status": "docker compose -f docker-compose.test.yml ps",
    "test:env:logs": "docker compose -f docker-compose.test.yml logs",
    "test:env:setup": "npm --prefix server run db:test:setup",
    "test:env:reset": "npm --prefix server run db:test:reset && npm run test:env:seed",
    "test:env:seed": "npm --prefix server run seed:test-accounts",
    "test:env:rebuild": "npm run test:env:down && npm run test:env:up && npm run test:env:setup && npm run test:env:seed",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:android": "npx cap open android",
    "mobile:build": "npm run build && npx cap sync android",
    "start": "vite preview --port 3000"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.28.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "firebase": "^11.10.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.2"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.21.5",
    "@rollup/rollup-linux-x64-gnu": "4.24.0",
    "@swc/core-linux-x64-gnu": "1.7.39"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "postcss": "^8.4.47",
    "sitemap": "^7.1.2",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^3.2.4"
  }
}
